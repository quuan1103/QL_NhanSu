@model WebAPP.Models.Luong.BangLuong
@{
	Layout = "~/Views/Shared/WebGD.cshtml";
}
<div class="container mt-4">
<div class="payroll-page">
<h2>Xóa bảng lương</h2>
<div class="card">
<div class="card-body">
<p>Bạn có chắc muốn xóa bảng lương tháng @Model.Thang/@Model.Nam?</p>
<form asp-action="Delete" method="post" class="d-flex gap-2">
	<input type="hidden" asp-for="Id" />
	<button class="btn btn-danger" type="submit">Xóa</button>
	<a class="btn btn-light" asp-action="Index">Hủy</a>
</form>
</div>
</div>
</div>
</div>



@model WebAPP.Controllers.DashboardViewModel
@{
    Layout = "~/Views/Shared/WebGD.cshtml";
}

<style>
.dashboard-container {
    background: #f8f9fa;
    min-height: 100vh;
    padding: 20px;
}

.main-content-frame {
    background: white;
    border: 1px solid #dee2e6;
    overflow: hidden;
}

.dashboard-header {
    background: #dc3545;
    color: white;
    padding: 15px 20px;
    margin: 0;
    border-bottom: 1px solid #c82333;
}

.dashboard-title {
    color: white;
    font-weight: 600;
    font-size: 1.5rem;
    margin: 0;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    padding: 20px;
}

.stat-card {
    background: white;
    border: 1px solid #dee2e6;
    padding: 20px;
    text-align: center;
    transition: box-shadow 0.3s ease;
}

.stat-card:hover {
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.stat-icon {
    font-size: 2.5rem;
    margin-bottom: 10px;
}

.stat-number {
    font-size: 2rem;
    font-weight: 700;
    color: #dc3545;
    margin-bottom: 5px;
}

.stat-label {
    color: #6c757d;
    font-weight: 500;
    font-size: 0.9rem;
}

.content-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    padding: 0 20px 20px;
}

.content-card {
    background: white;
    border: 1px solid #dee2e6;
    padding: 20px;
}

.content-title {
    font-size: 1.2rem;
    font-weight: 600;
    color: #212529;
    margin-bottom: 15px;
    padding-bottom: 10px;
    border-bottom: 2px solid #dc3545;
}

.nhanvien-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 0;
    border-bottom: 1px solid #f8f9fa;
}

.nhanvien-item:last-child {
    border-bottom: none;
}

.nhanvien-name {
    font-weight: 500;
    color: #212529;
}

.nhanvien-gender {
    background: #e9ecef;
    color: #495057;
    padding: 2px 8px;
    border-radius: 12px;
    font-size: 0.8rem;
}

.nhanvien-date {
    color: #6c757d;
    font-size: 0.8rem;
}

.chart-container {
    height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f8f9fa;
    border-radius: 5px;
    margin-top: 15px;
}

.simple-chart {
    display: flex;
    align-items: end;
    gap: 20px;
    height: 150px;
}

.chart-bar {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
}

.bar {
    width: 40px;
    background: #dc3545;
    border-radius: 3px 3px 0 0;
    transition: all 0.3s ease;
}

.bar:hover {
    background: #c82333;
}

.bar-label {
    font-size: 0.8rem;
    color: #6c757d;
    font-weight: 500;
}

.bar-value {
    font-size: 0.9rem;
    color: #212529;
    font-weight: 600;
}

@@media (max-width: 768px) {
    .content-grid {
        grid-template-columns: 1fr;
    }
    
    .stats-grid {
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    }
}
</style>

<div class="dashboard-container">
    <div class="main-content-frame">
        <div class="dashboard-header">
            <h1 class="dashboard-title">
                Dashboard - Tổng quan hệ thống
            </h1>
        </div>

        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon">👥</div>
                <div class="stat-number">@Model.TotalNhanVien</div>
                <div class="stat-label">Tổng nhân viên</div>
            </div>
            
            <div class="stat-card">
                <div class="stat-icon">🏢</div>
                <div class="stat-number">@Model.TotalPhongBan</div>
                <div class="stat-label">Phòng ban</div>
            </div>
            
            <div class="stat-card">
                <div class="stat-icon">💰</div>
                <div class="stat-number">@Model.TotalBangLuong</div>
                <div class="stat-label">Bảng lương</div>
            </div>
            
            <div class="stat-card">
                <div class="stat-icon">📚</div>
                <div class="stat-number">@Model.TotalDaoTao</div>
                <div class="stat-label">Khóa đào tạo</div>
            </div>
            
            <div class="stat-card">
                <div class="stat-icon">💵</div>
                <div class="stat-number">@Model.TongThucLinh.ToString("#,0", new System.Globalization.CultureInfo("vi-VN"))</div>
                <div class="stat-label">Tổng thực lĩnh (VNĐ)</div>
            </div>
        </div>

        <div class="content-grid">
            <div class="content-card">
                <h3 class="content-title">Nhân viên mới nhất</h3>
                @if (Model.NhanVienMoiNhat.Any())
                {
                    @foreach (var nv in Model.NhanVienMoiNhat)
                    {
                        <div class="nhanvien-item">
                            <div>
                                <div class="nhanvien-name">@nv.HoTen</div>
                                <div class="nhanvien-date">@nv.NgayTao.ToString("dd/MM/yyyy")</div>
                            </div>
                            <span class="nhanvien-gender">@nv.GioiTinh</span>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted">Chưa có dữ liệu nhân viên</p>
                }
            </div>

            <div class="content-card">
                <h3 class="content-title">Thống kê giới tính</h3>
                @if (Model.ThongKeGioiTinh.Any())
                {
                    <div class="chart-container">
                        <div class="simple-chart">
                            @foreach (var item in Model.ThongKeGioiTinh)
                            {
                                var maxValue = Model.ThongKeGioiTinh.Max(x => x.SoLuong);
                                var height = maxValue > 0 ? (item.SoLuong * 100.0 / maxValue) : 0;
                                
                                <div class="chart-bar">
                                    <div class="bar" style="height: @(height)px;"></div>
                                    <div class="bar-label">@item.GioiTinh</div>
                                    <div class="bar-value">@item.SoLuong</div>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <p class="text-muted">Chưa có dữ liệu thống kê</p>
                }
            </div>
        </div>
    </div>
</div>
